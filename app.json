{
  "expo": {
    "name": "MotoTracker",
    "slug": "moto-tracker",
    "version": "1.0.0",
    "icon": "./assets/mototracker-icon.png",
    "orientation": "portrait",
    "scheme": "mototracker",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.mototracker.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/mototracker-icon.png",
        "backgroundColor": "#101B3D"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/mototracker-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#101B3D",
          "dark": {
            "image": "./assets/mototracker-icon.png",
            "backgroundColor": "#101216"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MotoTracker to select a photo for your vehicle.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
